<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="raisetech.StudentManagement.repository.StudentRepository">

  <!-- 受講生の全件検索 -->
  <select id="searchStudentList" resultType="raisetech.StudentManagement.data.Student">
    SELECT *
    FROM students
    WHERE deleted = false
  </select>

  <!-- 受講生の検索 -->
  <select id="searchStudent" resultType="raisetech.StudentManagement.data.Student">
    SELECT *
    FROM students
    WHERE id = #{id} AND deleted = false
  </select>

  <!-- 受講生コース情報の全件検索 -->
  <select id="searchStudentCourseList" resultType="raisetech.StudentManagement.data.StudentCourse">
    SELECT *
    FROM students_courses
  </select>

  <!-- 受講生コース情報の検索 -->
  <select id="searchStudentCourse" resultType="raisetech.StudentManagement.data.StudentCourse">
    SELECT *
    FROM students_courses
    WHERE id = #{id}
  </select>

  <!-- 受講生IDに紐づく受講生コース情報を検索 -->
  <select id="searchStudentCourseListById"
    resultType="raisetech.StudentManagement.data.StudentCourse">
    Select *
    From students_courses
    WHERE student_id = #{studentId}
  </select>

  <!-- 受講生を新規登録します。IDに関しては自動採番を行う -->
  <insert id="registerStudent">
    INSERT INTO students(id, name, furigana, nickname, email, address, age, gender, remark, deleted)
    VALUES(#{student.id}, #{student.name}, #{student.furigana}, #{student.nickname},
    #{student.email}, #{student.address}, #{student.age}, #{student.gender}, #{student.remark},
    false)
    <selectKey keyProperty="student.id" resultType="java.lang.String" order="BEFORE">
      SELECT UUID()
    </selectKey>
  </insert>

  <!-- 受講生コース情報を新規登録します。IDに関しては自動採番を行う -->
  <insert id="registerStudentCourse">
    INSERT INTO students_courses(id, student_id, course_name, course_start_at, course_end_at)
    VALUES(#{studentCourse.id}, #{studentCourse.studentId},
    #{studentCourse.courseName}, #{studentCourse.courseStartAt}, #{studentCourse.courseEndAt})
    <selectKey keyProperty="studentCourse.id" resultType="java.lang.String" order="BEFORE">
      SELECT UUID()
    </selectKey>
  </insert>

  <!-- 受講生を更新します。 -->
  <update id="updateStudent">
    UPDATE students
    SET id=#{id}, name=#{name}, furigana=#{furigana}, nickname=#{nickname}, email=#{email},
    address=#{address}, age=#{age}, gender=#{gender}, remark=#{remark}, deleted=#{deleted}
    WHERE id=#{id}
  </update>

  <!-- 受講生コース情報のコース名を更新します。 -->
  <update id="updateStudentCourse">
    UPDATE students_courses
    SET course_name=#{courseName}, course_start_at=#{courseStartAt}, course_end_at=#{courseEndAt}
    WHERE id=#{id}
  </update>

  <!--  受講生コース申込状況の全件検索をします。 -->
  <select id="searchStudentCourseRegistrationStatus"
    resultType="raisetech.StudentManagement.domain.StudentCourseRegistrationStatus">
    SELECT *
    FROM registration_status;
  </select>

  <!--  受講生コース申込状況のIDによる１件検索をします。 -->
  <select id="searchStudentCourseRegistrationStatusById"
    resultType="raisetech.StudentManagement.domain.StudentCourseRegistrationStatus">
    SELECT *
    FROM registration_status
    WHERE id=#{id};
  </select>

  <!--  受講生コース申込状況の登録をします。-->
  <insert id="registerStudentCourseRegistrationStatus">
    INSERT INTO registration_status(id, student_course_id, status)
    VALUES(#{studentCourseRegistrationStatus.id},
    #{studentCourseRegistrationStatus.studentCourseId},
    #{studentCourseRegistrationStatus.status})
  </insert>

  <!--  受講生コース申込状況を更新します。 -->
  <insert id="updateStudentCourseRegistrationStatus">
    UPDATE registration_status
    SET student_course_id=#{studentCourseRegistrationStatus.studentCourseId},
    status=#{studentCourseRegistrationStatus.status}
    WHERE id=#{studentCourseRegistrationStatus.id}
  </insert>

  <!--  受講生の名前による絞り込み検索です。 -->
  <select id="searchStudentListByName"
    resultType="raisetech.StudentManagement.data.Student">
    SELECT *
    FROM students
    WHERE name Like CONCAT('%', #{name},'%');
  </select>

  <!--  受講生のフリガナによる絞り込み検索です。 -->
  <select id="searchStudentListFilteredByFurigana"
    resultType="raisetech.StudentManagement.data.Student">
    SELECT * FROM students
    WHERE furigana Like CONCAT('%', #{furigana}, '%');
  </select>

</mapper>